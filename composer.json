{
    "name": "breadthe/laravel-starter-timezone",
    "description": "Timezone scaffolding for Laravel's Livewire starter kit.",
    "keywords": [
        "laravel",
        "timezone",
        "fortify",
        "livewire",
        "starter-kit"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "breadthe"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/fortify": "^1.20",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Breadthe\\StarterTimezone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Breadthe\\StarterTimezone\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Breadthe\\StarterTimezone\\StarterTimezoneServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
